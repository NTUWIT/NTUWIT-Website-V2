DATABASE_URL=""

PISTON_URL="http://localhost:2000"
PISTON_TOKEN=""

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."
# Keep every Clerk redirect on our own sign-in page rather than the hosted
# account portal. Sign-up is intentionally absent: access is invite-only,
# granted from the Clerk dashboard (Access mode -> Invite-only).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/ide

# Participants join the IDE with a display name, no account. Set "invite" to
# require Clerk accounts instead. Admin always needs Clerk. A value that is
# set but not exactly "none" or "invite" means invite-only. Redeploy after
# changing it in Vercel.
# AUTH_MODE_OVERRIDE=invite

# Signs guest cookies (required unless AUTH_MODE_OVERRIDE=invite). At least 32 bytes:
# openssl rand -base64 48
GUEST_COOKIE_SECRET=""
